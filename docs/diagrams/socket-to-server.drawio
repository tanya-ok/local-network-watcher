<mxfile host="app.diagrams.net" modified="2026-11-24T12:00:00.000Z" agent="Local Watch" version="25.0.3" type="device">
  <diagram id="socket-journey" name="Socket to server">
    <mxGraphModel dx="1500" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="The flight path of a connection&#xa;One illustrative message, with a real network view underneath" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#29372f;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="70" as="geometry"/></mxCell>
        <mxCell id="lane-user" value="WHAT YOU CAN PICTURE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#68796e;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="220" height="25" as="geometry"/></mxCell>
        <mxCell id="n1" value="1 · Dispatch desk / App&#xa;Sender starts the trip&#xa;&#xa;The app asks macOS for a communication endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5edf5;strokeColor=#4c74a1;fontColor=#29372f;fontSize=14;spacing=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="n2" value="2 · OS gate / Socket&#xa;A managed doorway&#xa;&#xa;The socket is a kernel endpoint; the app uses a file-descriptor handle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7efe5;strokeColor=#63895d;fontColor=#29372f;fontSize=14;spacing=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="245" y="150" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="n3" value="3 · Cargo marks / Bytes&#xa;Words become numbers&#xa;&#xa;“Hi” → UTF-8 → 48 69 (hex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eedc;strokeColor=#a58b45;fontColor=#29372f;fontSize=14;spacing=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="n4" value="4 · Sealed cargo / TLS&#xa;A protected message&#xa;&#xa;When used, TLS protects records with negotiated traffic keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9f4;strokeColor=#806b9b;fontColor=#29372f;fontSize=14;spacing=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="655" y="150" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="n5" value="5 · Route slip / TCP-IP&#xa;Delivery labels&#xa;&#xa;Ports deliver to apps; IP addresses help routers forward packets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4eef0;strokeColor=#568392;fontColor=#29372f;fontSize=14;spacing=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="n6" value="6 · Transit hubs / Wi‑Fi&#xa;Many short legs&#xa;&#xa;Routers forward each packet to its next hop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3efed;strokeColor=#428985;fontColor=#29372f;fontSize=14;spacing=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1065" y="150" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="n7" value="7 · Arrivals / Server&#xa;Destination receives cargo&#xa;&#xa;TLS peers can decrypt protected records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8e2;strokeColor=#b27554;fontColor=#29372f;fontSize=14;spacing=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1270" y="150" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#718075;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#718075;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#718075;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#718075;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#718075;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#718075;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="lane-eng" value="ENGINEER VIEW · SELECT THE CORRESPONDING STEP IN THE APP" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#68796e;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="600" height="25" as="geometry"/></mxCell>
        <mxCell id="socket-note" value="socket() → file descriptor&#xa;connect() → remote peer&#xa;Kernel tracks protocol + local/remote endpoints." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f6ef;strokeColor=#c9c5b7;fontColor=#29372f;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="245" y="370" width="175" height="100" as="geometry"/></mxCell>
        <mxCell id="bytes-note" value="UTF-8 example&#xa;H = 0x48 = 01001000&#xa;i = 0x69 = 01101001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f6ef;strokeColor=#c9c5b7;fontColor=#29372f;fontSize=12;spacing=10;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="450" y="370" width="175" height="100" as="geometry"/></mxCell>
        <mxCell id="tls-note" value="TLS handshake negotiates keys&#xa;TLS records protect app data&#xa;Packet capture sees metadata; payload is encrypted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f6ef;strokeColor=#c9c5b7;fontColor=#29372f;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="655" y="370" width="175" height="100" as="geometry"/></mxCell>
        <mxCell id="transport-note" value="TCP segment / UDP datagram&#xa;IP packet&#xa;Wi‑Fi link frame (next hop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f6ef;strokeColor=#c9c5b7;fontColor=#29372f;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="860" y="370" width="175" height="100" as="geometry"/></mxCell>
        <mxCell id="caveat" value="THE PLANE IS A MEMORY AID, NOT A PACKET COUNTER · TEACHING EXAMPLE, NOT A LIVE PAYLOAD TRACE&#xa;The app’s text, TLS record, TCP segment and captured packet do not necessarily have matching boundaries. Port 443 alone is not proof that TLS was negotiated. TShark can inspect packet fields, not decrypt app content by itself. The live monitor reports observed endpoints and packet fields, not application plaintext." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eee4;strokeColor=#d3bda7;fontColor=#4b514b;fontSize=13;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1405" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
